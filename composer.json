{
	"name": "pronamic/wp-orbis-monitoring",
	"description": "The Orbis Monitoring plugin extends your Orbis environment with the option to monitor websites.",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"orbis",
		"monitoring",
		"wordpress",
		"plugin"
	],
	"homepage": "https://www.pronamic.eu/orbis/",
	"authors": [
		{
			"name": "Remco Tolsma",
			"email": "info@remcotolsma.nl",
			"homepage": "http://www.remcotolsma.nl",
			"role": "Developer"
		},
		{
			"name": "Karel-Jan Tolsma",
			"email": "info@kareljantolsma.nl",
			"homepage": "http://www.kareljantolsma.nl",
			"role": "Developer"
		}
	],
	"support": {
		"email": "support@pronamic.nl",
		"issues": "https://github.com/pronamic/wp-orbis-monitoring/issues",
		"source": "https://github.com/pronamic/wp-orbis-monitoring"
	},
	"type": "wordpress-plugin",
	"require": {
		"php": "^8.3",
		"automattic/jetpack-autoloader": "^6.0",
		"composer/installers": "^2.3"
	},
	"autoload": {
		"psr-4": {
			"Pronamic\\Orbis\\Monitoring\\": "psr-4/"
		}
	},
	"config": {
		"allow-plugins": {
			"automattic/jetpack-autoloader": true,
			"composer/installers": true,
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"roots/wordpress-core-installer": true
		},
		"platform": {
			"php": "8.3"
		},
		"platform-check": false,
		"sort-packages": true
	},
	"require-dev": {
		"deployer/deployer": "^7.5",
		"pronamic/wp-coding-standards": "^2.1",
		"roots/wordpress-no-content": "^7.1",
		"wp-cli/dist-archive-command": "*",
		"wp-cli/wp-cli-bundle": "*"
	},
	"extra": {
		"installer-paths": {
			"packages/{$vendor}/{$name}": [
				"vendor:pronamic",
				"vendor:solvebeam",
				"vendor:wp-pay",
				"woocommerce/action-scheduler"
			]
		},
		"wp-slug": "orbis-monitoring"
	},
	"scripts": {
		"build": [
			"rm -rf ./build/stage-1",
			"rsync --recursive --verbose --exclude-from=.distignore --exclude=/vendor/ ./ ./build/stage-1/",
			"composer install --no-dev --prefer-dist --optimize-autoloader --working-dir=./build/stage-1/",
			"rsync --recursive --delete --delete-excluded --verbose --exclude-from=.distignore ./build/stage-1/ ./build/orbis-monitoring/",
			"vendor/bin/wp i18n make-pot ./build/orbis-monitoring/ --slug=orbis-monitoring",
			"vendor/bin/wp i18n make-mo ./build/orbis-monitoring/languages/",
			"vendor/bin/wp dist-archive ./build/orbis-monitoring/ --plugin-dirname=orbis-monitoring --force"
		],
		"deploy": [
			"Composer\\Config::disableProcessTimeout",
			"DEPLOYER_IMPORT=${DEPLOYER_IMPORT:-$HOME/deployer.php} vendor/bin/dep deploy"
		],
		"dist-archive": "wp dist-archive . --plugin-dirname=orbis-monitoring",
		"make-pot": [
			"@build",
			"rsync --recursive --delete --verbose ./build/orbis-monitoring/languages/ ./languages/",
			"vendor/bin/wp i18n update-po ./languages/orbis-monitoring.pot"
		],
		"phpcs": "vendor/bin/phpcs",
		"qa": [
			"@phpcs"
		]
	}
}
