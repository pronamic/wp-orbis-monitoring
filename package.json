{
	"name": "@pronamic/wp-orbis-monitoring",
	"version": "1.0.0",
	"description": "The Orbis Monitoring plugin extends your Orbis environment with the option to monitor websites.",
	"author": "Pronamic",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"pronamic",
		"orbis",
		"monitoring"
	],
	"homepage": "https://github.com/pronamic/wp-orbis-monitoring#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pronamic/wp-orbis-monitoring.git"
	},
	"bugs": {
		"url": "https://github.com/pronamic/wp-orbis-monitoring/issues"
	},
	"dependencies": {
		"chart.js": "4.6.1"
	},
	"devDependencies": {
		"@wordpress/env": "^12.0.0",
		"@wordpress/scripts": "^37.0.0"
	},
	"prettier": "@wordpress/prettier-config",
	"scripts": {
		"lint:pkg-json": "wp-scripts lint-pkg-json",
		"build": "npm run build:chartjs",
		"build:chartjs": "mkdir -p assets/chart.js && cp node_modules/chart.js/dist/chart.umd.min.js node_modules/chart.js/dist/chart.umd.min.js.map node_modules/chart.js/LICENSE.md assets/chart.js/"
	}
}
